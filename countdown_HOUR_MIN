
<!DOCTYPE html>
<html>
<body>

<script>
let h = Number(prompt("Enter hours:"));
let m = Number(prompt("Enter minutes:"));
let s = Number(prompt("Enter seconds:"));

if (
    !Number.isInteger(h) || h < 0 ||
    !Number.isInteger(m) || m < 0 || m > 59 ||
    !Number.isInteger(s) || s < 0 || s > 59 ||
    (h === 0 && m === 0 && s === 0)
) {
    document.write("Please enter valid time.");
} else {

    let total = h * 3600 + m * 60 + s;

    function displayTime() {
        let hours = Math.floor(total / 3600);
        let minutes = Math.floor((total % 3600) / 60);
        let seconds = total % 60;

        document.getElementById("timer").innerHTML =
            String(hours).padStart(2, '0') + ":" +
            String(minutes).padStart(2, '0') + ":" +
            String(seconds).padStart(2, '0');
    }

    document.write("Countdown Timer: <span id='timer'></span>");

    displayTime();

    let x = setInterval(function () {
        total--;

        if (total <= 0) {
            clearInterval(x);
            document.getElementById("timer").innerHTML = "Time Up!";
        } else {
            displayTime();
        }
    }, 1000);
}
</script>

</body>
</html>
